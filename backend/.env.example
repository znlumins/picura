# Picura Golang Backend Configuration

# Server Port
PORT=8080

# PostgreSQL Database (Same as Prisma / Supabase / Cloud Postgres)
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# JWT Secret Key for Authentication
JWT_SECRET=picura-super-production-secret-jwt-key-2026-xyz

# SociaBuzz Integration Settings
# Username akun kreator SociaBuzz Anda (misal: "picura" -> https://sociabuzz.com/picura/tribe)
SOCIABUZZ_USERNAME=mindyourkills
SOCIABUZZ_API_KEY=

# Next.js Frontend URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
